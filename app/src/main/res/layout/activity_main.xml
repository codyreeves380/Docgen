<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Case Document Generator"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <Button android:id="@+id/btn_select_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Step 1: Select Word Template"
            android:background="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/txt_selected_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file selected"
            android:textColor="#757575"
            android:layout_marginBottom="16dp"
            android:textAlignment="center"/>

        <EditText android:id="@+id/input_defendant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Defendant Name" />

        <EditText android:id="@+id/input_causeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cause Number" />

        <EditText android:id="@+id/input_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Date" />

        <EditText android:id="@+id/input_defid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Defendant ID" />

        <EditText android:id="@+id/input_deposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Deposit amount" />

        <EditText android:id="@+id/input_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Day 1st" />

        <EditText android:id="@+id/input_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Month" />

        <EditText android:id="@+id/input_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Year" />

        <EditText android:id="@+id/input_compliance_officer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Compliance Officer Name ([[CO]])" />

        <EditText android:id="@+id/input_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number ([[PHONE]])"
            android:inputType="phone" />

        <EditText android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email Address ([[EMAIL]])"
            android:inputType="textEmailAddress" />

        <EditText android:id="@+id/input_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CO Badge ID # ([[BADGE]])" />

        <EditText android:id="@+id/input_gps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="$` for GPS Security Deposit ([[GPS]])"
            android:inputType="numberDecimal" />

        <EditText android:id="@+id/input_program"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="`$ for Program ([[PRO]])"
            android:inputType="numberDecimal" />

        <EditText android:id="@+id/input_tax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="$` for TAX ([[TAX]])"
            android:inputType="numberDecimal" />

        <EditText android:id="@+id/input_judge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Judge Name ([[JUDGE]])" />

        <Button android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Step 2: Generate Document"
            android:layout_marginTop="20dp"
            android:background="#2196F3"
            android:textColor="#FFFFFF"/>

