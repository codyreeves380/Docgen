<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121820">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Case Document Generator"
            android:textColor="#F3F6FA"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Enter the details below to prepare your document."
            android:textColor="#AAB7C4"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_select_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#16825D"
            android:text="Step 1: Select Word Template"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/txt_selected_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="No file selected"
            android:textColor="#AAB7C4"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Case details"
            android:textColor="#F3F6FA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_defendant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Defendant Name ([[DEFENDANT]])"
                android:inputType="textCapWords"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_defendant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_causeno"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Cause Number ([[CAUSENO]])"
                android:inputType="text"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_causeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Full Date ([[DATE]])"
                android:inputType="date"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_defid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Defendant ID ([[DEFID]])"
                android:inputType="text"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_defid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_deposit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Deposit amount ([[DEPOSIT]])"
                android:inputType="numberDecimal"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_deposit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Day ([[DAY]])"
                android:inputType="text"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Month ([[MONTH]])"
                android:inputType="text"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_year"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Year ([[YEAR]])"
                android:inputType="number"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
                android:textColor="#F3F6FA" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Officer and court details"
            android:textColor="#F3F6FA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_compliance_officer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#526273"
                android:hint="Compliance Officer Name ([[CO]])"
                android:inputType="textCapWords"
                android:textColor="#F3F6FA"
                android:textColorHint="#AAB7C4" />

            <CheckBox
                android:id="@+id/save_compliance_officer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#16825D"
                android:text="Save"
